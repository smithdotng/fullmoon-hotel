# Copy to .env (or .env.local) and fill in the real values.

# --- Database -----------------------------------------------------------------
MONGODB_URI=mongodb://localhost:27017/fullmoonhotel

# --- Sessions -----------------------------------------------------------------
# At least 32 random characters, e.g. `openssl rand -base64 32`
SESSION_SECRET=
# Set to false only if the site is served over plain http in production
# COOKIE_SECURE=false

# --- Site ---------------------------------------------------------------------
# Public URL used for Open Graph links
SITE_URL=https://fullmoon.found.ng
# Uploads: on Vercel, connecting a Blob store sets this and uploads go to Vercel Blob
# BLOB_READ_WRITE_TOKEN=
# Self-hosted only: where uploaded images are stored (default: ./storage/uploads)
# UPLOAD_DIR=/var/www/fullmoon/uploads

# --- reCAPTCHA (contact form) -----------------------------------------------------
# Keys from https://www.google.com/recaptcha/admin. Add your domains there
# (e.g. fullmoon.found.ng and your-project.vercel.app). Until both keys are set
# the contact form works but is not protected.
RECAPTCHA_SITE_KEY=
RECAPTCHA_SECRET_KEY=
# v3 (invisible, default) or v2 (the "I'm not a robot" checkbox) - must match the key type
RECAPTCHA_VERSION=v3
# v3 only: reject submissions scoring below this (0.0 = bot, 1.0 = human)
RECAPTCHA_MIN_SCORE=0.5

# --- Email (SMTP) -------------------------------------------------------------
# The mail server for fullmoon-hotels.com (smtp.fullmoon-hotels.com does NOT exist)
EMAIL_HOST=mail.fullmoon-hotels.com
# 465 = SSL/TLS (recommended). Use 587 if your server blocks 465.
EMAIL_PORT=465
# Full mailbox address and its password
EMAIL_USER=reservations@fullmoon-hotels.com
EMAIL_PASS=
# Optional: address emails are sent "from" (defaults to EMAIL_USER)
EMAIL_FROM=reservations@fullmoon-hotels.com
# Optional: comma-separated copies of every reservation confirmation
EMAIL_CC=
EMAIL_BCC=
# Where contact-form and gym enquiries are delivered
CONTACT_EMAIL=info@fullmoon-hotels.com
GYM_ENQUIRY_EMAIL=reservations@fullmoon-hotels.com
