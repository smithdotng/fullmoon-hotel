# Copy to .env on the server and fill in the real values.

# --- Email (SMTP) -------------------------------------------------------------
# The mail server for fullmoon-hotels.com (smtp.fullmoon-hotels.com does NOT exist)
EMAIL_HOST=mail.fullmoon-hotels.com
# 465 = SSL/TLS (recommended). Use 587 if your server blocks 465.
EMAIL_PORT=465
# Full mailbox address and its password
EMAIL_USER=reservations@fullmoon-hotels.com
EMAIL_PASS=
# Optional: address emails are sent "from" (defaults to EMAIL_USER)
EMAIL_FROM=reservations@fullmoon-hotels.com
# Optional: comma-separated copies of every reservation confirmation
EMAIL_CC=
EMAIL_BCC=
# Where contact-form and gym enquiries are delivered
CONTACT_EMAIL=info@fullmoon-hotels.com
GYM_ENQUIRY_EMAIL=reservations@fullmoon-hotels.com
