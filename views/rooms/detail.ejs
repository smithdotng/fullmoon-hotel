                                                    </div>
                                                </div>
                                            </div>
                                        </div>

                                        <!-- === Book This Room Button === -->
                                        <div class="room-block text-center">
                                            <a href="/rooms/<%= room._id %>" class="btn btn-main btn-lg">
                                                Book This Room
