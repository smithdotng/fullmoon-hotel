<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title><%= title %> - Full Moon Hotels</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.1.3/dist/css/bootstrap.min.css" rel="stylesheet">
    <link href="https://cdn.datatables.net/1.11.5/css/dataTables.bootstrap5.min.css" rel="stylesheet">
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.8.1/font/bootstrap-icons.css">
    <style>
        .reservation-card {
            border-left: 4px solid;
            margin-bottom: 15px;
        }
        .status-pending { border-color: #ffc107; }
        .status-confirmed { border-color: #28a745; }
        .status-cancelled { border-color: #dc3545; }
        .payment-unpaid { background-color: #fff3cd; }
        .payment-paid { background-color: #d4edda; }
        .badge-status { font-size: 0.8em; }
    </style>
</head>
<body>
    <nav class="navbar navbar-expand-lg navbar-dark bg-dark">
        <div class="container-fluid">
            <a class="navbar-brand" href="/admin">Full Moon Hotels Admin</a>
            <div class="collapse navbar-collapse">
                <ul class="navbar-nav me-auto">
                    <li class="nav-item">
                        <a class="nav-link" href="/admin">Dashboard</a>
                    </li>
                    <li class="nav-item">
                        <a class="nav-link active" href="/manage-reservations">Reservations</a>
                    </li>
                    <li class="nav-item">
                        <a class="nav-link" href="/admin/rooms">Rooms</a>
                    </li>
                </ul>
                <span class="navbar-text">
                    Welcome, <%= user.username %> | 
                    <a href="/logout" class="text-white">Logout</a>
                </span>
            </div>
        </div>
    </nav>

    <div class="container-fluid mt-4">
        <div class="row">
            <div class="col-md-12">
                <h1 class="h3 mb-4"><i class="bi bi-calendar-check"></i> Manage Reservations</h1>
                
                <% if (messages.error) { %>
                    <div class="alert alert-danger alert-dismissible fade show" role="alert">
                        <%= messages.error %>
                        <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
                    </div>
                <% } %>
                
                <% if (messages.success) { %>
                    <div class="alert alert-success alert-dismissible fade show" role="alert">
                        <%= messages.success %>
                        <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
                    </div>
                <% } %>

                <!-- Dashboard Stats -->
                <div class="row mb-4">
                    <div class="col-md-3">
                        <div class="card text-white bg-primary">
                            <div class="card-body">
                                <h5 class="card-title">Total Reservations</h5>
                                <h2 class="card-text"><%= totals.total %></h2>
                            </div>
                        </div>
                    </div>
                    <div class="col-md-3">
                        <div class="card text-white bg-warning">
                            <div class="card-body">
                                <h5 class="card-title">Pending</h5>
                                <h2 class="card-text"><%= totals.pending %></h2>
                            </div>
                        </div>
                    </div>
                    <div class="col-md-3">
                        <div class="card text-white bg-success">
                            <div class="card-body">
                                <h5 class="card-title">Confirmed</h5>
                                <h2 class="card-text"><%= totals.confirmed %></h2>
                            </div>
                        </div>
                    </div>
                    <div class="col-md-3">
                        <div class="card text-white bg-danger">
                            <div class="card-body">
                                <h5 class="card-title">Unpaid</h5>
                                <h2 class="card-text"><%= totals.unpaid %></h2>
                            </div>
                        </div>
                    </div>
                </div>

                <!-- Filters -->
                <div class="card mb-4">
                    <div class="card-body">
                        <form method="GET" class="row g-3">
                            <div class="col-md-3">
                                <label class="form-label">Status</label>
                                <select name="status" class="form-select">
                                    <option value="all" <%= query.status === 'all' ? 'selected' : '' %>>All Statuses</option>
                                    <option value="pending" <%= query.status === 'pending' ? 'selected' : '' %>>Pending</option>
                                    <option value="confirmed" <%= query.status === 'confirmed' ? 'selected' : '' %>>Confirmed</option>
                                    <option value="cancelled" <%= query.status === 'cancelled' ? 'selected' : '' %>>Cancelled</option>
                                </select>
                            </div>
                            <div class="col-md-3">
                                <label class="form-label">Payment</label>
                                <select name="payment" class="form-select">
                                    <option value="all" <%= query.payment === 'all' ? 'selected' : '' %>>All Payments</option>
                                    <option value="unpaid" <%= query.payment === 'unpaid' ? 'selected' : '' %>>Unpaid</option>
                                    <option value="paid" <%= query.payment === 'paid' ? 'selected' : '' %>>Paid</option>
                                </select>
                            </div>
                            <div class="col-md-3">
                                <label class="form-label">Date</label>
                                <input type="date" name="date" class="form-control" value="<%= query.date || '' %>">
                            </div>
                            <div class="col-md-3">
                                <label class="form-label">Search</label>
                                <input type="text" name="search" class="form-control" placeholder="Name, email, phone..." value="<%= query.search || '' %>">
                            </div>
                            <div class="col-12">
                                <button type="submit" class="btn btn-primary"><i class="bi bi-filter"></i> Filter</button>
                                <a href="/manage-reservations" class="btn btn-secondary">Clear</a>
                                <a href="/manage-reservations/export/csv" class="btn btn-success"><i class="bi bi-download"></i> Export CSV</a>
                            </div>
                        </form>
                    </div>
                </div>

                <!-- Reservations Table -->
                <div class="card">
                    <div class="card-body">
                        <div class="table-responsive">
                            <table class="table table-hover" id="reservationsTable">
                                <thead>
                                    <tr>
                                        <th>Guest</th>
                                        <th>Room</th>
                                        <th>Dates</th>
                                        <th>Amount</th>
                                        <th>Status</th>
                                        <th>Payment</th>
                                        <th>Actions</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    <% reservations.forEach(res => { %>
                                    <tr class="<%= res.paymentStatus === 'unpaid' ? 'payment-unpaid' : 'payment-paid' %>">
                                        <td>
                                            <strong><%= res.guestName %></strong><br>
                                            <small class="text-muted"><%= res.guestEmail %></small><br>
                                            <small class="text-muted"><%= res.guestPhone %></small>
                                        </td>
                                        <td><%= res.room?.type || 'N/A' %></td>
                                        <td>
                                            <strong>Check-in:</strong> <%= res.formattedCheckIn %><br>
                                            <strong>Check-out:</strong> <%= res.formattedCheckOut %><br>
                                            <small><%= res.nights %> night(s), <%= res.guests %> guest(s)</small>
                                        </td>
                                        <td><%= res.formattedAmount %></td>
                                        <td>
                                            <span class="badge <%= res.status === 'confirmed' ? 'bg-success' : res.status === 'pending' ? 'bg-warning' : 'bg-danger' %> badge-status">
                                                <%= res.status.toUpperCase() %>
                                            </span>
                                        </td>
                                        <td>
                                            <% if (res.paymentStatus === 'paid') { %>
                                                <span class="badge bg-success badge-status">PAID</span><br>
                                                <small><%= res.paymentMethod %></small>
                                                <% if (res.receiptNumber) { %>
                                                    <br><small>Receipt: <%= res.receiptNumber %></small>
                                                <% } %>
                                            <% } else { %>
                                                <span class="badge bg-danger badge-status">UNPAID</span>
                                            <% } %>
                                        </td>
                                        <td>
                                            <a href="/manage-reservations/<%= res._id %>" class="btn btn-sm btn-info">
                                                <i class="bi bi-eye"></i> View
                                            </a>
                                            <% if (res.paymentStatus === 'unpaid') { %>
                                                <a href="/manage-reservations/<%= res._id %>" class="btn btn-sm btn-success">
                                                    <i class="bi bi-cash"></i> Confirm Payment
                                                </a>
                                            <% } %>
                                        </td>
                                    </tr>
                                    <% }); %>
                                </tbody>
                            </table>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <script src="https://code.jquery.com/jquery-3.6.0.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.1.3/dist/js/bootstrap.bundle.min.js"></script>
    <script src="https://cdn.datatables.net/1.11.5/js/jquery.dataTables.min.js"></script>
    <script src="https://cdn.datatables.net/1.11.5/js/dataTables.bootstrap5.min.js"></script>
    <script>
        $(document).ready(function() {
            $('#reservationsTable').DataTable({
                pageLength: 25,
                order: [[0, 'desc']]
            });
        });
    </script>
</body>
</html>