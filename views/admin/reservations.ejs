<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title><%= title %></title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.1.3/dist/css/bootstrap.min.css" rel="stylesheet">
    <link href="https://cdn.datatables.net/1.11.5/css/dataTables.bootstrap5.min.css" rel="stylesheet">
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.8.1/font/bootstrap-icons.css">
    <style>
        .stats-card {
            border-radius: 10px;
            padding: 15px;
            margin-bottom: 15px;
            color: white;
        }
        .bg-total { background: linear-gradient(135deg, #667eea 0%, #764ba2 100%); }
        .bg-pending { background: linear-gradient(135deg, #f093fb 0%, #f5576c 100%); }
        .bg-confirmed { background: linear-gradient(135deg, #4facfe 0%, #00f2fe 100%); }
        .bg-paid { background: linear-gradient(135deg, #43e97b 0%, #38f9d7 100%); }
        .badge-status { font-size: 0.8em; }
        .status-pending { background-color: #ffc107; }
        .status-confirmed { background-color: #28a745; }
        .status-cancelled { background-color: #dc3545; }
        .payment-unpaid { background-color: #ffcccb; }
        .payment-paid { background-color: #d4edda; }
    </style>
</head>
<body>
    <nav class="navbar navbar-expand-lg navbar-dark bg-dark">
        <div class="container-fluid">
            <a class="navbar-brand" href="/admin">Full Moon Hotels Admin</a>
            <div class="collapse navbar-collapse">
                <ul class="navbar-nav me-auto">
                    <li class="nav-item">
                        <a class="nav-link" href="/admin">Dashboard</a>
                    </li>
                    <li class="nav-item">
                        <a class="nav-link active" href="/rooms/admin/reservations">Reservations</a>
                    </li>
                    <li class="nav-item">
                        <a class="nav-link" href="/admin/rooms">Rooms</a>
                    </li>
                </ul>
                <span class="navbar-text">
                    Welcome, <%= user.username %> | 
                    <a href="/logout" class="text-white">Logout</a>
                </span>
            </div>
        </div>
    </nav>

    <div class="container-fluid mt-4">
        <div class="row">
            <div class="col-md-12">
                <h1 class="h3 mb-4"><i class="bi bi-calendar-check"></i> Manage Reservations</h1>
                
                <% if (messages.error) { %>
                    <div class="alert alert-danger alert-dismissible fade show" role="alert">
                        <%= messages.error %>
                        <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
                    </div>
                <% } %>
                
                <% if (messages.success) { %>
                    <div class="alert alert-success alert-dismissible fade show" role="alert">
                        <%= messages.success %>
                        <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
                    </div>
                <% } %>

                <!-- Stats Dashboard -->
                <div class="row mb-4">
                    <div class="col-md-2">
                        <div class="stats-card bg-total">
                            <h5 class="card-title">Total</h5>
                            <h2 class="card-text"><%= stats.total %></h2>
                        </div>
                    </div>
                    <div class="col-md-2">
                        <div class="stats-card bg-pending">
                            <h5 class="card-title">Pending</h5>
                            <h2 class="card-text"><%= stats.pending %></h2>
                        </div>
                    </div>
                    <div class="col-md-2">
                        <div class="stats-card bg-confirmed">
                            <h5 class="card-title">Confirmed</h5>
                            <h2 class="card-text"><%= stats.confirmed %></h2>
                        </div>
                    </div>
                    <div class="col-md-2">
                        <div class="stats-card" style="background: linear-gradient(135deg, #dc3545 0%, #c82333 100%);">
                            <h5 class="card-title">Cancelled</h5>
                            <h2 class="card-text"><%= stats.cancelled %></h2>
                        </div>
                    </div>
                    <div class="col-md-2">
                        <div class="stats-card" style="background: linear-gradient(135deg, #ffc107 0%, #e0a800 100%);">
                            <h5 class="card-title">Unpaid</h5>
                            <h2 class="card-text"><%= stats.unpaid %></h2>
                        </div>
                    </div>
                    <div class="col-md-2">
                        <div class="stats-card bg-paid">
                            <h5 class="card-title">Paid</h5>
                            <h2 class="card-text"><%= stats.paid %></h2>
                        </div>
                    </div>
                </div>

                <!-- Filters -->
                <div class="card mb-4">
                    <div class="card-body">
                        <form method="GET" class="row g-3">
                            <div class="col-md-2">
                                <label class="form-label">Status</label>
                                <select name="status" class="form-select">
                                    <option value="all" <%= query.status === 'all' ? 'selected' : '' %>>All Statuses</option>
                                    <option value="pending" <%= query.status === 'pending' ? 'selected' : '' %>>Pending</option>
                                    <option value="confirmed" <%= query.status === 'confirmed' ? 'selected' : '' %>>Confirmed</option>
                                    <option value="cancelled" <%= query.status === 'cancelled' ? 'selected' : '' %>>Cancelled</option>
                                </select>
                            </div>
                            <div class="col-md-2">
                                <label class="form-label">Payment</label>
                                <select name="payment" class="form-select">
                                    <option value="all" <%= query.payment === 'all' ? 'selected' : '' %>>All Payments</option>
                                    <option value="unpaid" <%= query.payment === 'unpaid' ? 'selected' : '' %>>Unpaid</option>
                                    <option value="paid" <%= query.payment === 'paid' ? 'selected' : '' %>>Paid</option>
                                </select>
                            </div>
                            <div class="col-md-2">
                                <label class="form-label">Check-in Date</label>
                                <input type="date" name="date" class="form-control" value="<%= query.date || '' %>">
                            </div>
                            <div class="col-md-2">
                                <label class="form-label">Reserved From</label>
                                <input type="date" name="createdFrom" class="form-control" value="<%= query.createdFrom || '' %>">
                            </div>
                            <div class="col-md-2">
                                <label class="form-label">Reserved To</label>
                                <input type="date" name="createdTo" class="form-control" value="<%= query.createdTo || '' %>">
                            </div>
                            <div class="col-md-2">
                                <label class="form-label">Search</label>
                                <input type="text" name="search" class="form-control" placeholder="Name, email, phone..." value="<%= query.search || '' %>">
                            </div>
                            <div class="col-12">
                                <button type="submit" class="btn btn-primary"><i class="bi bi-filter"></i> Filter</button>
                                <a href="/rooms/admin/reservations" class="btn btn-secondary">Clear</a>
                            </div>
                        </form>
                    </div>
                </div>

                <!-- Reservations Table -->
                <div class="card">
                    <div class="card-body">
                        <div class="table-responsive">
                            <table class="table table-hover" id="reservationsTable">
                                <thead>
                                    <tr>
                                        <th>Reserved Date</th>
                                        <th>Guest</th>
                                        <th>Room</th>
                                        <th>Dates</th>
                                        <th>Amount</th>
                                        <th>Status</th>
                                        <th>Payment</th>
                                        <th>Actions</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    <% reservations.forEach(res => { %>
                                    <tr class="<%= res.paymentStatus === 'unpaid' ? 'payment-unpaid' : 'payment-paid' %>">
                                        <td>
                                            <small><%= res.formattedCreatedAt || (res.createdAt ? new Date(res.createdAt).toLocaleDateString('en-GB') : 'N/A') %></small>
                                        </td>
                                        <td>
                                            <strong><%= res.guestName %></strong><br>
                                            <small class="text-muted"><%= res.guestEmail %></small><br>
                                            <small class="text-muted"><%= res.guestPhone %></small>
                                        </td>
                                        <td><%= res.room?.type || 'N/A' %><br><small><%= res.room?.roomNumber || '' %></small></td>
                                        <td>
                                            <small><strong>Check-in:</strong> <%= res.formattedCheckIn || (res.checkIn ? new Date(res.checkIn).toLocaleDateString('en-GB') : 'N/A') %></small><br>
                                            <small><strong>Check-out:</strong> <%= res.formattedCheckOut || (res.checkOut ? new Date(res.checkOut).toLocaleDateString('en-GB') : 'N/A') %></small><br>
                                            <small><%= res.nights %> night(s), <%= res.guests %> guest(s)</small>
                                        </td>
                                        <td>₦<%= (res.totalAmount || 0).toLocaleString() %></td>
                                        <td>
                                            <span class="badge <%= res.status === 'confirmed' ? 'bg-success' : res.status === 'pending' ? 'bg-warning' : 'bg-danger' %> badge-status">
                                                <%= res.status ? res.status.toUpperCase() : 'UNKNOWN' %>
                                            </span>
                                        </td>
                                        <td>
                                            <% if (res.paymentStatus === 'paid') { %>
                                                <span class="badge bg-success badge-status">PAID</span><br>
                                                <small><%= res.paymentMethod || '' %></small>
                                                <% if (res.receiptNumber) { %>
                                                    <br><small>Receipt: <%= res.receiptNumber %></small>
                                                <% } %>
                                            <% } else { %>
                                                <span class="badge bg-danger badge-status">UNPAID</span>
                                            <% } %>
                                        </td>
                                        <td>
                                            <a href="/rooms/admin/reservations/<%= res._id %>" class="btn btn-sm btn-info mb-1">
                                                <i class="bi bi-eye"></i> View
                                            </a>
                                            <% if (res.paymentStatus === 'unpaid') { %>
                                                <a href="/rooms/admin/reservations/<%= res._id %>" class="btn btn-sm btn-success mb-1">
                                                    <i class="bi bi-cash"></i> Confirm Payment
                                                </a>
                                            <% } %>
                                        </td>
                                    </tr>
                                    <% }); %>
                                </tbody>
                            </table>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <script src="https://code.jquery.com/jquery-3.6.0.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.1.3/dist/js/bootstrap.bundle.min.js"></script>
    <script src="https://cdn.datatables.net/1.11.5/js/jquery.dataTables.min.js"></script>
    <script src="https://cdn.datatables.net/1.11.5/js/dataTables.bootstrap5.min.js"></script>
    <script>
        $(document).ready(function() {
            $('#reservationsTable').DataTable({
                pageLength: 25,
                order: [[0, 'desc']], // Sort by reserved date (newest first)
                columnDefs: [
                    { 
                        targets: 0, // Reserved Date column
                        type: 'date', // Tell DataTables this is a date column
                        render: function(data, type, row) {
                            if (type === 'sort' || type === 'type') {
                                // Convert displayed date to sortable format
                                const dateParts = data.split('/');
                                if (dateParts.length === 3) {
                                    // Convert DD/MM/YYYY to YYYY-MM-DD for sorting
                                    return dateParts[2] + '-' + dateParts[1] + '-' + dateParts[0];
                                }
                                return data;
                            }
                            return data;
                        }
                    }
                ],
                language: {
                    search: "Search reservations:",
                    lengthMenu: "Show _MENU_ reservations per page",
                    info: "Showing _START_ to _END_ of _TOTAL_ reservations",
                    paginate: {
                        first: "First",
                        last: "Last",
                        next: "Next",
                        previous: "Previous"
                    }
                }
            });
        });
    </script>
</body>
</html>