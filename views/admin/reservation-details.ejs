<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title><%= title %></title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.1.3/dist/css/bootstrap.min.css" rel="stylesheet">
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.8.1/font/bootstrap-icons.css">
    <style>
        .detail-card { border-left: 4px solid #007bff; }
        .payment-form-section { background-color: #e8f4f8; border-radius: 8px; }
        .notes-box { background-color: #f8f9fa; border-left: 4px solid #6c757d; }
    </style>
</head>
<body>
    <nav class="navbar navbar-expand-lg navbar-dark bg-dark">
    <div class="container-fluid">
        <a class="navbar-brand" href="/admin">Full Moon Hotels Admin</a>
        <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#navbarNav">
            <span class="navbar-toggler-icon"></span>
        </button>
        <div class="collapse navbar-collapse" id="navbarNav">
            <ul class="navbar-nav me-auto">
                <li class="nav-item">
                    <a class="nav-link" href="/admin">
                        <i class="bi bi-speedometer2"></i> Dashboard
                    </a>
                </li>
                <li class="nav-item">
                    <a class="nav-link active" href="/rooms/admin/reservations">
                        <i class="bi bi-calendar-check"></i> Reservations
                    </a>
                </li>
                <li class="nav-item">
                    <a class="nav-link" href="/admin/rooms">
                        <i class="bi bi-house-door"></i> Rooms
                    </a>
                </li>
                <li class="nav-item">
                    <a class="nav-link" href="/admin/facilities">
                        <i class="bi bi-building"></i> Facilities
                    </a>
                </li>
                <li class="nav-item">
                    <a class="nav-link" href="/admin/blog">
                        <i class="bi bi-newspaper"></i> Blog
                    </a>
                </li>
                <li class="nav-item">
                    <a class="nav-link" href="/admin/users">
                        <i class="bi bi-people"></i> Users
                    </a>
                </li>
            </ul>
            <span class="navbar-text">
                Welcome, <%= user.username %> | 
                <a href="/logout" class="text-white">
                    <i class="bi bi-box-arrow-right"></i> Logout
                </a>
            </span>
        </div>
    </div>
</nav>

    <div class="container mt-4">
        <div class="row">
            <div class="col-md-12">
                <h1 class="h3 mb-4">
                    <i class="bi bi-person-badge"></i> Reservation Details
                    <span class="badge <%= reservation.status === 'confirmed' ? 'bg-success' : reservation.status === 'pending' ? 'bg-warning' : 'bg-danger' %>">
                        <%= reservation.status.toUpperCase() %>
                    </span>
                </h1>
                
                <% if (messages.error) { %>
                <div class="alert alert-danger alert-dismissible fade show" role="alert">
                    <%= messages.error %>
                    <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
                </div>
                <% } %>
                
                <% if (messages.success) { %>
                <div class="alert alert-success alert-dismissible fade show" role="alert">
                    <%= messages.success %>
                    <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
                </div>
                <% } %>

                <div class="row">
                    <!-- Left Column - Reservation Details -->
                    <div class="col-md-8">
                        <div class="card detail-card mb-4">
                            <div class="card-body">
                                <h5 class="card-title">Guest Information</h5>
                                <div class="row">
                                    <div class="col-md-6">
                                        <p><strong>Name:</strong> <%= reservation.guestName %></p>
                                        <p><strong>Email:</strong> <%= reservation.guestEmail %></p>
                                        <p><strong>Phone:</strong> <%= reservation.guestPhone %></p>
                                    </div>
                                    <div class="col-md-6">
                                        <p><strong>Reservation ID:</strong> <%= reservation._id %></p>
                                        <p><strong>Created:</strong> <%= new Date(reservation.createdAt).toLocaleString() %></p>
                                    </div>
                                </div>
                            </div>
                        </div>

                        <div class="card detail-card mb-4">
                            <div class="card-body">
                                <h5 class="card-title">Booking Details</h5>
                                <div class="row">
                                    <div class="col-md-6">
                                        <p><strong>Room:</strong> <%= reservation.room?.type || 'N/A' %></p>
                                        <p><strong>Room Number:</strong> <%= reservation.room?.roomNumber || 'N/A' %></p>
                                        <p><strong>Check-in:</strong> <%= reservation.formattedCheckIn %></p>
                                        <p><strong>Check-out:</strong> <%= reservation.formattedCheckOut %></p>
                                    </div>
                                    <div class="col-md-6">
                                        <p><strong>Nights:</strong> <%= reservation.nights %></p>
                                        <p><strong>Guests:</strong> <%= reservation.guests %></p>
                                        <p><strong>Room Rate:</strong> ₦<%= (reservation.roomRate || 0).toLocaleString() %> per night</p>
                                        <p><strong>Total Amount:</strong> ₦<%= (reservation.totalAmount || 0).toLocaleString() %></p>
                                    </div>
                                </div>
                            </div>
                        </div>

                        <!-- Payment Information -->
                        <div class="card detail-card mb-4">
                            <div class="card-body">
                                <h5 class="card-title">Payment Information</h5>
                                <div class="row">
                                    <div class="col-md-6">
                                        <p><strong>Status:</strong> 
                                            <span class="badge <%= reservation.paymentStatus === 'paid' ? 'bg-success' : 'bg-danger' %>">
                                                <%= reservation.paymentStatus ? reservation.paymentStatus.toUpperCase().replace('_', ' ') : 'UNKNOWN' %>
                                            </span>
                                        </p>
                                        <% if (reservation.paymentMethod) { %>
                                            <p><strong>Method:</strong> <%= reservation.paymentMethod.toUpperCase() %></p>
                                        <% } %>
                                        <% if (reservation.receiptNumber) { %>
                                            <p><strong>Receipt No:</strong> <%= reservation.receiptNumber %></p>
                                        <% } %>
                                        <% if (reservation.transactionNo) { %>
                                            <p><strong>Transaction No:</strong> <%= reservation.transactionNo %></p>
                                        <% } %>
                                        <% if (reservation.bankName) { %>
                                            <p><strong>Bank:</strong> <%= reservation.bankName %></p>
                                        <% } %>
                                        <% if (reservation.sessionId) { %>
                                            <p><strong>Session ID:</strong> <%= reservation.sessionId %></p>
                                        <% } %>
                                        <% if (reservation.cardType) { %>
                                            <p><strong>Card Type:</strong> <%= reservation.cardType %></p>
                                        <% } %>
                                    </div>
                                </div>
                            </div>
                        </div>

                        <!-- Notes -->
                        <div class="card notes-box mb-4">
                            <div class="card-body">
                                <h5 class="card-title">Notes</h5>
                                <% if (reservation.notes) { %>
                                    <pre style="white-space: pre-wrap; font-family: inherit;"><%= reservation.notes %></pre>
                                <% } else { %>
                                    <p class="text-muted">No notes</p>
                                <% } %>
                            </div>
                        </div>
                    </div>

                    <!-- Right Column - Actions -->
                    <div class="col-md-4">
                        <!-- Payment Confirmation (only if unpaid) -->
                        <% if (reservation.paymentStatus === 'unpaid') { %>
                        <div class="card payment-form-section mb-4">
                            <div class="card-body">
                                <h5 class="card-title text-success"><i class="bi bi-cash"></i> Confirm Payment</h5>
                                <form action="/rooms/admin/reservations/<%= reservation._id %>/confirm-payment" method="POST">
                                    
                                    <div class="mb-3">
                                        <label class="form-label">Payment Method *</label>
                                        <select name="paymentMethod" id="paymentMethod" class="form-select" required>
                                            <option value="">Select method</option>
                                            <option value="cash">Cash</option>
                                            <option value="transfer">Bank Transfer</option>
                                            <option value="pos">POS</option>
                                        </select>
                                    </div>

                                    <!-- Cash Fields -->
                                    <div id="cashFields" class="payment-method-fields" style="display: none;">
                                        <div class="mb-3">
                                            <label class="form-label">Receipt Number *</label>
                                            <input type="text" name="receiptNumber" class="form-control" placeholder="e.g., REC-00123">
                                        </div>
                                    </div>

                                    <!-- Transfer Fields -->
                                    <!-- Update the Transfer Fields section: -->
<div id="transferFields" class="payment-method-fields" style="display: none;">
    <div class="mb-3">
        <label class="form-label">Bank Name *</label>
        <input type="text" name="bankName" class="form-control" placeholder="e.g., Access Bank">
    </div>
    <div class="mb-3">
        <label class="form-label">Transaction Number *</label>
        <input type="text" name="transferTransactionNo" class="form-control" placeholder="e.g., TXN-456789">
    </div>
    <div class="mb-3">
        <label class="form-label">Session ID *</label>
        <input type="text" name="sessionId" class="form-control" placeholder="e.g., SESS-12345">
    </div>
</div>

<!-- Update the POS Fields section: -->
<div id="posFields" class="payment-method-fields" style="display: none;">
    <div class="mb-3">
        <label class="form-label">Card Type *</label>
        <select name="cardType" class="form-control">
            <option value="visa">Visa</option>
            <option value="mastercard">MasterCard</option>
            <option value="verve">Verve</option>
            <option value="amex">American Express</option>
        </select>
    </div>
    <div class="mb-3">
        <label class="form-label">Transaction Number *</label>
        <input type="text" name="posTransactionNo" class="form-control" placeholder="e.g., TXN-456789">
    </div>
</div>

                                    <div class="mb-3">
                                        <label class="form-label">Notes</label>
                                        <textarea name="notes" class="form-control" rows="3" placeholder="Any additional notes..."></textarea>
                                    </div>

                                    <button type="submit" class="btn btn-success w-100">
                                        <i class="bi bi-check-circle"></i> Confirm Payment
                                    </button>
                                </form>
                            </div>
                        </div>
                        <% } else { %>
                        <div class="card bg-light mb-4">
                            <div class="card-body text-center">
                                <i class="bi bi-check-circle-fill text-success" style="font-size: 3rem;"></i>
                                <h5 class="mt-3">Payment Confirmed</h5>
                                <p class="text-muted">This reservation has been paid</p>
                            </div>
                        </div>
                        <% } %>

                        <!-- Status Update -->
                        <div class="card mb-4">
                            <div class="card-body">
                                <h5 class="card-title">Update Status</h5>
                                <form action="/rooms/admin/reservations/<%= reservation._id %>/update-status" method="POST">
                                    <select name="status" class="form-select mb-3">
                                        <option value="pending" <%= reservation.status === 'pending' ? 'selected' : '' %>>Pending</option>
                                        <option value="confirmed" <%= reservation.status === 'confirmed' ? 'selected' : '' %>>Confirmed</option>
                                        <option value="cancelled" <%= reservation.status === 'cancelled' ? 'selected' : '' %>>Cancelled</option>
                                    </select>
                                    <button type="submit" class="btn btn-primary w-100">Update Status</button>
                                </form>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.1.3/dist/js/bootstrap.bundle.min.js"></script>
    <script>
        // Show/hide payment method fields
       // Show/hide payment method fields
       const paymentMethodSelect = document.getElementById('paymentMethod');
if (paymentMethodSelect) {
    paymentMethodSelect.addEventListener('change', function() {
        document.querySelectorAll('.payment-method-fields').forEach(field => {
            field.style.display = 'none';
            field.querySelectorAll('input, select').forEach(input => {
                input.removeAttribute('required');
            });
        });
        
        const selectedMethod = this.value;
        if (selectedMethod === 'cash') {
            const cashFields = document.getElementById('cashFields');
            if (cashFields) {
                cashFields.style.display = 'block';
                document.querySelectorAll('#cashFields input').forEach(input => {
                    input.setAttribute('required', 'required');
                });
            }
        } else if (selectedMethod === 'transfer') {
            const transferFields = document.getElementById('transferFields');
            if (transferFields) {
                transferFields.style.display = 'block';
                document.querySelectorAll('#transferFields input').forEach(input => {
                    input.setAttribute('required', 'required');
                });
            }
        } else if (selectedMethod === 'pos') {
            const posFields = document.getElementById('posFields');
            if (posFields) {
                posFields.style.display = 'block';
                document.querySelectorAll('#posFields input, #posFields select').forEach(input => {
                    input.setAttribute('required', 'required');
                });
            }
        }
    });
}
            
    </script>
</body>
</html>