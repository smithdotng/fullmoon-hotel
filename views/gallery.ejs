                                    </div>

                                    <!-- === Swimming Pool === -->
                                    <div class="col-xs-6 col-md-4">
                                        <figure>
                                            <a href="/assets/images/facility-pool.jpg" title="Swimming Pool">
                                                <figcaption style="background-image:url(/assets/images/facility-pool.jpg)">
                                                    <img src="/assets/images/facility-pool.jpg" alt="Swimming Pool" />
                                                </figcaption>
                                                <span class="btn btn-clean">Swimming Pool</span>
                                            </a>
                                        </figure>
                                    </div>

                                    <!-- === Business Center === -->
                                    <div class="col-xs-6 col-md-4">
                                        <figure>
                                            <a href="/assets/images/facility-business.jpg" title="Business Center">
                                                <figcaption style="background-image:url(/assets/images/facility-business.jpg)">
                                                    <img src="/assets/images/facility-business.jpg" alt="Business Center" />
                                                </figcaption>
                                                <span class="btn btn-clean">Business Center</span>
                                            </a>
                                        </figure>
                                    </div>

                                    <!-- === Event Spaces === -->
                                    <div class="col-xs-6 col-md-4">
                                        <figure>
                                            <a href="/assets/images/facility-event.jpg" title="Event Spaces">
                                                <figcaption style="background-image:url(/assets/images/facility-event.jpg)">
                                                    <img src="/assets/images/facility-event.jpg" alt="Event Spaces" />
