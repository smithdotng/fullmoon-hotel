                                    </div>

                                </div> <!--/row-->
                            </div> <!--/container-->
                        </div>

                        <!-- Continue with the same pattern for other sections (Dining, Events, Exterior) -->
                        <!-- Make sure to update ALL figure elements in the same way -->

                    </section> <!--/cards-->

                    <!-- Call to Action -->
                    <div class="text-center" style="padding: 50px 0;">
                        <h3>Experience Our Luxury Firsthand</h3>
                        <p class="lead" style="margin: 20px 0;">Book your stay and create your own memorable moments at Full Moon Hotels</p>
                        <a href="/rooms" class="btn btn-main btn-lg">View Rooms & Suites</a>
                        <a href="/contact" class="btn btn-default btn-lg">Contact Us</a>
