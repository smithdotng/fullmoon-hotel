<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="utf-8">
    <meta http-equiv="X-UA-Compatible" content="IE=edge">
    <meta name="viewport" content="width=device-width, initial-scale=1, maximum-scale=1">

    <!-- Mobile Web-app fullscreen -->
    <meta name="apple-mobile-web-app-capable" content="yes">
    <meta name="mobile-web-app-capable" content="yes">

    <!-- Meta tags -->
    <meta name="description" content="<%= description %>">
    <meta name="author" content="Full Moon Hotels">
    <link rel="icon" href="/favicon.ico">

    <!--Title-->
    <title><%= title %></title>

    <!-- Open Graph Meta Tags -->
    <meta property="og:title" content="<%= title %>">
    <meta property="og:description" content="<%= description %>">
    <meta property="og:type" content="website">
    <meta property="og:url" content="https://fullmoon.found.ng<%= typeof url !== 'undefined' ? url : '' %>">
    <meta property="og:image" content="https://fullmoon.found.ng/1.jpg">
    <meta property="og:image:width" content="1200">
    <meta property="og:image:height" content="630">
    <meta property="og:image:alt" content="Full Moon Hotels Gallery">
    <meta property="og:site_name" content="Full Moon Hotels">
    <meta property="og:locale" content="en_US">

    <!--CSS styles-->
    <link rel="stylesheet" media="all" href="/css/bootstrap.css" />
    <link rel="stylesheet" media="all" href="/css/animate.css" />
    <link rel="stylesheet" media="all" href="/css/font-awesome.css" />
    <link rel="stylesheet" media="all" href="/css/linear-icons.css" />
    <link rel="stylesheet" media="all" href="/css/hotel-icons.css" />
    <link rel="stylesheet" media="all" href="/css/magnific-popup.css" />
    <link rel="stylesheet" media="all" href="/css/owl.carousel.css" />
    <link rel="stylesheet" media="all" href="/css/datepicker.css" />
    <link rel="stylesheet" media="all" href="/css/theme.css" />

    <!--Google fonts-->
    <link href="https://fonts.googleapis.com/css?family=Montserrat:300,500&amp;subset=latin-ext" rel="stylesheet">
    <link href="https://fonts.googleapis.com/css?family=Playfair+Display:400,700&amp;subset=latin-ext" rel="stylesheet">

    <style>
        .gallery-filter {
            margin: 30px 0;
            text-align: center;
        }
        .filter-btn {
            background: transparent;
            border: 2px solid #c19b76;
            color: #c19b76;
            padding: 10px 25px;
            margin: 5px;
            border-radius: 25px;
            transition: all 0.3s ease;
            font-weight: 600;
        }
        .filter-btn:hover, .filter-btn.active {
            background: #c19b76;
            color: white;
            transform: translateY(-2px);
        }
        
        /* Fix for image loading and lightbox */
        .cards figure {
            position: relative;
            overflow: hidden;
        }
        .cards figure a {
            display: block;
            position: relative;
        }
        .cards figure img {
            width: 100%;
            height: auto;
            transition: transform 0.3s ease;
        }
        .cards figure:hover img {
            transform: scale(1.05);
        }
        .cards .btn-clean {
            position: absolute;
            bottom: 20px;
            left: 50%;
            transform: translateX(-50%);
            background: rgba(0,0,0,0.7);
            color: white;
            border: 2px solid white;
            padding: 8px 20px;
            text-decoration: none;
            transition: all 0.3s ease;
            z-index: 2;
        }
        .cards .btn-clean:hover {
            background: white;
            color: #333;
        }
    </style>
</head>

<body>

    <div class="page-loader"></div>

    <div class="wrapper">

        <!-- ======================== Gallery ======================== -->
        <section class="page">

            <!-- ===  Page header === -->
            <div class="page-header" style="background-image:url(/assets/images/header-1.jpg)">
                <div class="container">
                    <h2 class="title">Photo Gallery</h2>
                    <p>Discover the Beauty of Full Moon Hotels</p>
                </div>
            </div>

            <div class="gallery-page">
                <div class="container">

                    <!-- ======================== Cards Section ======================== -->
                    <section class="cards" style="padding-top: 200px;">

                        

                        <!-- === All Photos Section === -->
                        <div class="gallery-section" id="all-photos">
                            <div class="section-header">
                                <div class="container">
