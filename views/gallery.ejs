                                    <p>Explore our luxurious accommodations and premium facilities</p>
                                </div>
                            </div>

                            <!-- Gallery Filter -->
                        <div class="gallery-filter">
                            <button class="filter-btn active" data-filter="all">All Photos</button>
                            <button class="filter-btn" data-filter="rooms">Rooms & Suites</button>
                            <button class="filter-btn" data-filter="facilities">Facilities</button>
                            <button class="filter-btn" data-filter="dining">Dining</button>
                            <button class="filter-btn" data-filter="events">Events</button>
                            <button class="filter-btn" data-filter="exterior">Hotel Exterior</button>
                        </div>

                            <div class="container">
                                <div class="row">

                                    <!-- === Featured Item (Large) === -->
                                    <div class="col-xs-12 col-md-8">
                                        <figure>
                                            <a href="/assets/images/cigar-lounge.jpg" title="Chic Open-Air Escape">
                                                <figcaption style="background-image:url(/assets/images/cigar-lounge.jpg)">
                                                    <img src="/assets/images/cigar-lounge.jpg" alt="Chic Open-Air Escape" />
                                                </figcaption>
                                                <span class="btn btn-clean">Chic Open-Air Escape</span>
                                            </a>
                                        </figure>
                                    </div>

                                    <!-- === Premium Ambience === -->
                                    <div class="col-xs-6 col-md-4">
                                        <figure>
                                            <a href="/assets/images/lobby-1.jpg" title="Premium Ambience">
                                                <figcaption style="background-image:url(/assets/images/lobby-1.jpg)">
                                                    <img src="/assets/images/lobby-1.jpg" alt="Premium Ambience" />
                                                </figcaption>
                                                <span class="btn btn-clean">Premium Ambience</span>
                                            </a>
                                        </figure>
                                    </div>

                                    <!-- === Intimate Coffee Nook === -->
                                    <div class="col-xs-6 col-md-4">
                                        <figure>
                                            <a href="/assets/images/coffeebar-1.jpg" title="Intimate Coffee Nook">
                                                <figcaption style="background-image:url(/assets/images/coffeebar-1.jpg)">
                                                    <img src="/assets/images/coffeebar-1.jpg" alt="Intimate Coffee Nook" />
                                                </figcaption>
                                                <span class="btn btn-clean">Intimate Coffee Nook</span>
                                            </a>
                                        </figure>
                                    </div>

                                    <!-- === Karaoke Lounge === -->
                                    <div class="col-xs-6 col-md-4">
                                        <figure>
                                            <a href="/assets/images/karaoke-bar.jpg" title="Karaoke Lounge">
                                                <figcaption style="background-image:url(/assets/images/karaoke-bar.jpg)">
                                                    <img src="/assets/images/karaoke-bar.jpg" alt="Exclusive Music Lounge" />
                                                </figcaption>
                                                <span class="btn btn-clean">Karaoke Lounge</span>
                                            </a>
                                        </figure>
                                    </div>

                                    <!-- === Fine Dining === -->
                                    <div class="col-xs-6 col-md-4">
                                        <figure>
                                            <a href="/assets/images/gallery-dining.jpg" title="Fine Dining">
                                                <figcaption style="background-image:url(/assets/images/gallery-dining.jpg)">
                                                    <img src="/assets/images/gallery-dining.jpg" alt="Fine Dining" />
                                                </figcaption>
                                                <span class="btn btn-clean">Fine Dining</span>
                                            </a>
                                        </figure>
                                    </div>

                                </div> <!--/row-->
                            </div> <!--/container-->
                        </div>

                        <!-- === Rooms & Suites Section === -->
                        <div class="gallery-section" id="rooms-section" style="display: none;">
                            <div class="section-header">
                                <div class="container">
                                    <h2 class="title">Rooms & Suites</h2>
                                    <p>Luxurious accommodations for business and leisure</p>
                                </div>
                            </div>

                            <div class="container">
                                <div class="row">

                                    <!-- === Deluxe Room (Large) === -->
                                    <div class="col-xs-12 col-md-8">
                                        <figure>
                                            <a href="/assets/images/room-deluxe.jpg" title="Deluxe Room">
                                                <figcaption style="background-image:url(/assets/images/room-deluxe.jpg)">
                                                    <img src="/assets/images/room-deluxe.jpg" alt="Deluxe Room" />
                                                </figcaption>
                                                <span class="btn btn-clean">Deluxe Room</span>
                                            </a>
                                        </figure>
